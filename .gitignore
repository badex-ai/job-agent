
# ===========================================
# Job Agent - .gitignore
# ===========================================

# ----- Personal Data (MUST NOT be committed) -----
# Personal notes and documentation
txt/
v.txt
v2.txt
*.pdf

# Personal profile configuration (real path is shared/config/)
config/_profile.yml
shared/config/_profile.yml

# All personal job-search data: scraped postings, CVs, hand-labels, the DB,
# and the labeling working files. labels.json is ground truth but personal —
# back it up privately, never push it.
data/

# Local-only v2 tooling kept out of a clone but preserved for our own work:
#   labeling/ — the toolchain that produces hand-labels (may feed the retrain loop)
#   scratch/  — one-off probes, spikes, model comparisons
v2/labeling/
v2/scratch/

# ----- Environment & Secrets -----
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

# ----- IDE & Editor -----
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-workspace
*.sublime-project

# ----- Claude Code -----
.claude/

# ----- OS Files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----- Logs & Debug -----
*.log
logs/
debug/

# ----- Testing -----
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ----- Misc -----
*.bak
*.tmp
*.temp
